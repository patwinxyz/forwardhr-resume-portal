# Frontend (Firebase Auth)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_ADMIN_EMAILS=
VITE_TURNSTILE_SITE_KEY=

# Optional: if your API is hosted on another domain
# VITE_API_BASE_URL=https://your-domain.vercel.app

# Backend (Vercel Function /api/send-resume)
RESEND_API_KEY=
TURNSTILE_SECRET_KEY=
# MAIL_FROM can be either:
# 1) no-reply@forwardhrm.com
# 2) Forward HR <no-reply@forwardhrm.com>
MAIL_FROM=
# Optional display name used when MAIL_FROM is plain email
MAIL_FROM_NAME=Forward HR
# Comma-separated recipient emails
MAIL_TO=hr@forwardhrm.com
# Daily hard limits for /api/send-resume (Asia/Taipei date)
SEND_RESUME_DAILY_LIMIT_PER_UID=6
SEND_RESUME_DAILY_LIMIT_PER_IP=24

# Backend auth verification (pick one style)
# Backend admin permission (server side, comma separated emails)
ADMIN_EMAILS=

# A) Single JSON string from Firebase service account key
FIREBASE_SERVICE_ACCOUNT_JSON=

# B) Split fields (alternative to JSON)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
